{
  "name": "yardwork",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --mode pages",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "start": "tsx server/index.ts",
    "restore-workshop": "tsx server/restoreWorkshop.ts",
    "test": "tsx --test --test-concurrency=4 tests/*.test.ts",
    "test:e2e": "playwright test",
    "check:examples": "tsx scripts/export-studies.ts --check",
    "check": "npm run test && npm run check:examples && npm run build"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.6",
    "@react-three/fiber": "^9.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.181.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
